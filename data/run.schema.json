{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Real AI run manifest",
  "type": "object",
  "required": ["schemaVersion", "benchmark", "runs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmark": {
      "type": "object",
      "required": ["name", "goal", "normalizedReasoningBands", "updatedAt"]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "provider", "model", "harness", "reasoning", "run", "dataSource", "summary", "artifacts", "validation", "evaluation"]
      }
    }
  }
}
